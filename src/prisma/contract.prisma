// use prisma-8

enum UserRole {
  CUSTOMER
  ADMIN
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum PaymentMethod {
  COD
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole @default(CUSTOMER)

  cart           Cart?
  addresses      Address[]
  orders         Order[]
  wishlistItems  WishlistItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  price       Numeric
  description String
  categoryId  Int

  category      Category       @relation(fields: [categoryId], references: [id])
  cartItems     CartItem[]
  inventory     Inventory?
  orderItems    OrderItem[]
  wishlistItems WishlistItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Cart {
  id     Int @id @default(autoincrement())
  userId Int @unique

  user  User       @relation(fields: [userId], references: [id])
  items CartItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model CartItem {
  id        Int @id @default(autoincrement())
  quantity  Int
  cartId    Int
  productId Int

  cart    Cart    @relation(fields: [cartId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Inventory {
  id        Int @id @default(autoincrement())
  quantity  Int @default(0)
  productId Int @unique

  product Product @relation(fields: [productId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Address {
  id          Int     @id @default(autoincrement())
  userId      Int
  label       String
  fullAddress String
  city        String
  state       String
  pincode     String
  isDefault   Boolean @default(false)

  user User @relation(fields: [userId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Coupon {
  id             Int                @id @default(autoincrement())
  code           String             @unique
  discountType   CouponDiscountType
  discountValue  Numeric
  minOrderAmount Numeric             @default(0)
  maxDiscount    Numeric?
  expiresAt      TimestamptzString
  usageLimit     Int?
  usedCount      Int                @default(0)
  isActive       Boolean            @default(true)

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Order {
  id              Int           @id @default(autoincrement())
  userId          Int

  subtotal        Numeric
  discount        Numeric       @default(0)
  total           Numeric

  addressLabel    String
  fullAddress     String
  city            String
  state           String
  pincode         String

  couponCode      String?

  status          OrderStatus   @default(PLACED)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   PaymentMethod  @default(COD)

  user  User        @relation(fields: [userId], references: [id])
  items OrderItem[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model OrderItem {
  id        Int @id @default(autoincrement())
  orderId   Int
  productId Int

  productName String
  price       Numeric
  quantity    Int
  itemTotal   Numeric

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model WishlistItem {
  id        Int @id @default(autoincrement())
  userId    Int
  productId Int

  user    User    @relation(fields: [userId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@unique([userId, productId])
}